---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { getSiteConfig, getAllArticles, getAllTools } from '../lib/content';
import InteractiveCursor from '../components/InteractiveCursor';
import ScrollVernier from '../components/ScrollVernier';
import CommandPalette from '../components/CommandPalette';
import FloatingDock from '../components/FloatingDock';

interface Props {
  title?: string;
  description?: string;
  showBackHome?: boolean;
  fullBleed?: boolean;
}

const site = getSiteConfig();
const allArticles = await getAllArticles();
const allTools = await getAllTools();

const searchArticles = allArticles.map((a) => ({
  slug: a.slug,
  title: a.title,
  category: a.category,
}));

const searchTools = allTools.map((t) => ({
  name: t.name,
  group: t.group,
  url: t.url,
}));

const {
  title = `${site.siteName} · ${site.hero.subtitle}`,
  description = site.hero.description,
  showBackHome = false,
  fullBleed = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/ip/avatar-256.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="font-sans text-ink-900 selection:bg-[#C7EFDC]/70">
    <InteractiveCursor client:load />
    <ScrollVernier client:load />

    <!-- Global Command Palette (opened via ⌘K or Floating Dock search button, no navbar needed) -->
    <CommandPalette
      client:load
      hideTrigger={true}
      articles={searchArticles}
      tools={searchTools}
      email={site.contact.community.email.address}
    />

    {fullBleed ? (
      <main class="min-h-screen w-full">
        <slot />
      </main>
    ) : (
      <div class="mx-auto flex min-h-screen max-w-[960px] flex-col px-5 sm:px-8 pb-20">
        <!-- Subpage whisper-minimal top return bar (No full navbar) -->
        <div class="flex items-center justify-between pt-6 pb-2">
          <a
            href="/"
            class="group inline-flex items-center gap-2.5 rounded-full border border-paper-300/90 bg-paper-50/90 px-3 py-1.5 shadow-sm hover:border-[#27232D]/40 transition-colors"
          >
            <img
              src="/ip/avatar-64.png"
              width="24"
              height="24"
              alt={site.siteName}
              class="h-6 w-6 rounded-full bg-[#F3EBDD] object-cover"
            />
            <span class="text-xs font-extrabold text-ink-900">
              {site.siteName}
            </span>
          </a>

          <div class="flex items-center gap-1.5">
            {site.headerLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="tactile-btn inline-flex items-center gap-1 rounded-full border border-paper-300 bg-paper-50/90 px-2.5 py-1 text-xs font-semibold text-ink-800 hover:border-[#D95A49] hover:text-[#D95A49] transition-colors"
              >
                <span>{link.label}</span>
                <span aria-hidden="true" class="text-[10px] text-ink-400">↗</span>
              </a>
            ))}
          </div>
        </div>

        <main class="flex-1">
          <slot />
        </main>

        <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-paper-300/90 py-7 text-xs text-ink-600">
          <div class="flex items-center gap-2 font-mono">
            <span>{site.copyright}</span>
          </div>

          <div class="flex items-center gap-5 font-semibold">
            {showBackHome && (
              <a
                href="/"
                class="inline-flex items-center gap-1 text-ink-800 hover:text-terracotta-600 transition-colors"
              >
                <span>← 返回首页</span>
              </a>
            )}
          </div>
        </footer>
      </div>
    )}

    <!-- Sleek Bottom Floating Capsule Dock (hidden on 100vh opening screen, appears on scroll!) -->
    <FloatingDock client:load currentPath={currentPath} alwaysVisible={!isHome} />
  </body>
</html>
