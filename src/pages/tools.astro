---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolsArchiveView from '../components/ToolsArchiveView';
import { getSiteConfig, getAllTools } from '../lib/content';

const site = getSiteConfig();
const tools = await getAllTools();
---

<BaseLayout
  title={`开源与工具汇总 · ${site.siteName}`}
  description="收录经过实测的好用开源项目、实用 AI 工具，以及自研开源的模板与脚本"
  showBackHome={true}
>
  <section class="pt-9 pb-12">
    <div class="mb-8">
      <a
        href="/"
        class="inline-flex items-center gap-1 text-xs font-semibold text-ink-600 hover:text-terracotta-600 transition-colors"
      >
        <span>← 返回首页</span>
      </a>
      <div class="mt-4 flex items-center gap-2">
        <span class="h-1 w-6 rounded-full bg-sage-600"></span>
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-ink-400">
          OPEN SOURCE & TOOLS
        </span>
      </div>
      <h1 class="mt-2 text-2xl sm:text-3xl font-extrabold tracking-tight text-ink-900">
        开源项目与实用工具
      </h1>
      <p class="mt-2 text-sm sm:text-base text-ink-600">
        经过实测的好用开源项目、AI 提效工具与个人开源模板，支持直达仓库与配套教程联动
      </p>
    </div>

    <ToolsArchiveView
      client:load
      tools={tools}
      toolGroups={site.toolGroups}
    />
  </section>
</BaseLayout>
